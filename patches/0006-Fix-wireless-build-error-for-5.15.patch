From bd916d4fa868b932cfb4155f9a4b9032c6dc031c Mon Sep 17 00:00:00 2001
From: kwan1996 <laicheehou9@gmail.com>
Date: Thu, 31 Jul 2025 11:54:03 +0800
Subject: [PATCH 6/7] Fix wireless build error for 5.15

---
 net/wireless/nl80211.c | 14 ++++++++++++--
 net/wireless/sysfs.c   |  2 +-
 2 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/net/wireless/nl80211.c b/net/wireless/nl80211.c
index e84f978..f56e19b 100644
--- a/net/wireless/nl80211.c
+++ b/net/wireless/nl80211.c
@@ -16383,7 +16383,12 @@ static u32 nl80211_internal_flags[] = {
 #undef SELECTOR
 };
 
-static int nl80211_pre_doit(const struct genl_split_ops *ops,
+static int nl80211_pre_doit(
+#if LINUX_VERSION_IS_LESS(6,2,0)
+				const struct genl_ops *ops,
+#else
+				const struct genl_split_ops *ops,
+#endif
 			    struct sk_buff *skb,
 			    struct genl_info *info)
 {
@@ -16485,7 +16490,12 @@ out_unlock:
 	return err;
 }
 
-static void nl80211_post_doit(const struct genl_split_ops *ops,
+static void nl80211_post_doit(
+#if LINUX_VERSION_IS_LESS(6,2,0)
+				const struct genl_ops *ops,
+#else	
+				const struct genl_split_ops *ops,
+#endif
 			      struct sk_buff *skb,
 			      struct genl_info *info)
 {
diff --git a/net/wireless/sysfs.c b/net/wireless/sysfs.c
index 62f2661..86d4378 100644
--- a/net/wireless/sysfs.c
+++ b/net/wireless/sysfs.c
@@ -154,7 +154,7 @@ static SIMPLE_DEV_PM_OPS(wiphy_pm_ops, wiphy_suspend, wiphy_resume);
 #define WIPHY_PM_OPS NULL
 #endif
 
-static const void *wiphy_namespace(const struct device *d)
+static const void *wiphy_namespace(struct device *d)
 {
 	struct wiphy *wiphy = container_of(d, struct wiphy, dev);
 
-- 
