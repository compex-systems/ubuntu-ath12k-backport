 		goto nla_put_failure;
 
 	genlmsg_end(msg, hdr);
-
+#if LINUX_VERSION_IS_LESS(6,8,0)
+	rcu_read_lock();
+	genlmsg_multicast_allns(&nl80211_fam, msg, 0,
+				NL80211_MCGRP_REGULATORY, GFP_ATOMIC);
+	rcu_read_unlock();
+#else
 	genlmsg_multicast_allns(&nl80211_fam, msg, 0,
 				NL80211_MCGRP_REGULATORY);
-
+#endif
 	return;
 
 nla_put_failure:
@@ -18722,10 +18727,15 @@ void nl80211_send_beacon_hint_event(struct wiphy *wiphy,
 	nla_nest_end(msg, nl_freq);
 
 	genlmsg_end(msg, hdr);
-
+#if LINUX_VERSION_IS_LESS(6,8,0)
+	rcu_read_lock();
+	genlmsg_multicast_allns(&nl80211_fam, msg, 0,
+				NL80211_MCGRP_REGULATORY, GFP_ATOMIC);
+	rcu_read_unlock();
+#else
 	genlmsg_multicast_allns(&nl80211_fam, msg, 0,
 				NL80211_MCGRP_REGULATORY);
-
+#endif
 	return;
 
 nla_put_failure:
