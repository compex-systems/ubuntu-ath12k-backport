diff --git a/backport-include/linux/cleanup.h b/backport-include/linux/cleanup.h
new file mode 100644
index 0000000..a7b865b
--- /dev/null
+++ b/backport-include/linux/cleanup.h
@@ -0,0 +1,63 @@
+#ifndef _BACKPORT_LINUX_CLEANUP_H
+#define _BACKPORT_LINUX_CLEANUP_H
+#pragma GCC diagnostic ignored "-Wdeclaration-after-statement"
+
+#include <linux/version.h>
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 4, 0)
+#include_next <linux/cleanup.h>
+#else
+#include <linux/compiler.h>
+#include <linux/slab.h>
+#include <linux/mutex.h>
+#include <linux/rcupdate.h>
+
+#ifndef ___PASTE
+#define ___PASTE(a, b) a ## b
+#endif
+#ifndef __PASTE
+#define __PASTE(a, b) ___PASTE(a, b)
+#endif
+#ifndef __UNIQUE_ID
+#define __UNIQUE_ID(prefix) __PASTE(prefix, __LINE__)
+#endif
+
+#define DEFINE_CLASS(name, type, exit, init, init_args...) \
+	typedef type class_##name##_t; \
+	static inline void class_##name##_destructor(type *p) \
+	{ type _T = *p; exit; } \
+	static inline type class_##name##_constructor(init_args) \
+	{ type _obj = init; return _obj; }
+
+#define CLASS(name, var) \
+	class_##name##_t var __attribute__((__cleanup__(class_##name##_destructor), unused)) = \
+	class_##name##_constructor
+
+#define DEFINE_GUARD(name, type, lock, unlock) \
+	DEFINE_CLASS(name, type, unlock, ({ lock; _T; }), type _T)
+
+#define guard(name) \
+	CLASS(name, __UNIQUE_ID(guard))
+
+#define scoped_guard(name, args...) \
+	for (CLASS(name, __UNIQUE_ID(scope))(args), *__scoped_guard_done = NULL; \
+	     !__scoped_guard_done; __scoped_guard_done = (void *)1)
+
+DEFINE_GUARD(mutex, struct mutex *, mutex_lock(_T), mutex_unlock(_T))
+
+typedef int class_rcu_t;
+static inline void class_rcu_destructor(int *p) { rcu_read_unlock(); }
+static inline int class_rcu_constructor(void) { rcu_read_lock(); return 0; }
+
+#define __free(_name) __attribute__((__cleanup__(_name##_T_f)))
+
+static inline void kfree_T_f(void *p)
+{
+	void **_p = (void **)p;
+	if (_p && *_p)
+		kfree(*_p);
+}
+
+#endif /* LINUX_VERSION_CODE */
+
+#endif /* _BACKPORT_LINUX_CLEANUP_H */
